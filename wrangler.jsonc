{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "hermes-image",

  "main": "src/index.js",

  "compatibility_date": "2026-07-07",

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "ai": {
    "binding": "AI"
  }

